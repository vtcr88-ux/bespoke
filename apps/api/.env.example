NODE_ENV=development
PORT=3333
DATABASE_URL=mysql://bespoke_app:bespoke_dev_password@127.0.0.1:3306/bespoke
COMMERCE_STORAGE=mysql
INSTANCE_ID=bespoke-local
SESSION_SECRET=replace_with_32_bytes_minimum
CSRF_SECRET=replace_with_another_32_bytes_minimum
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_scrypt_hash
ADMIN_SESSION_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=info
MERCADO_PAGO_ACCESS_TOKEN=TEST-replace_me
MERCADO_PAGO_WEBHOOK_SECRET=replace_me
WHATSAPP_STORE_PHONE=5511999999999
PUBLIC_API_URL=http://localhost:3333
PUBLIC_WEB_URL=http://localhost:5173
UPLOADS_DIR=storage/bespoke-local/uploads

# Optional ngrok values for local Mercado Pago webhook testing
# Install ngrok locally in the repo with: npm install --save-dev ngrok
# Validate the local ngrok setup with: npm run ngrok:check
# Start the restricted webhook tunnel with: npm run ngrok
# Then update PUBLIC_API_URL to the generated ngrok HTTPS base URL and restart the API.
