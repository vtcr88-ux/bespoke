{
  "name": "@bespoke/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "auth:hash-password": "tsx --conditions=development scripts/hash-admin-password.ts",
    "auth:verify-password": "tsx --conditions=development scripts/verify-admin-password.ts",
    "db:setup": "tsx ../../scripts/db-setup.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bespoke/contracts": "0.1.0",
    "@bespoke/server-auth": "0.1.0",
    "@thiagoprazeres/pix-static-brcode": "^1.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mercadopago": "^3.2.0",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "qrcode": "^1.5.4",
    "sharp": "0.35.3",
    "vite": "8.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
