server {
  listen 80;
  listen [::]:80;
  server_name __PUBLIC_DOMAIN__;
  root __APP_ROOT__/current/apps/web/dist;
  index index.html;

  include /etc/nginx/snippets/catalog-security-headers.conf;
  add_header Content-Security-Policy "frame-ancestors 'self' https://__ADMIN_DOMAIN__" always;

  location ~ ^/api/admin(?:/|$) {
    return 404;
  }

  location ~ ^/(?:admin(?:/|$)|painel-[A-Za-z0-9_-]{24,}(?:/|$)) {
    return 404;
  }

  location /api/ {
    limit_req zone=public_api burst=40 nodelay;
    limit_conn per_ip 30;
    client_max_body_size 256k;
    proxy_pass http://127.0.0.1:__API_PORT__/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location = /index.html {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy "frame-ancestors 'self' https://__ADMIN_DOMAIN__" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
