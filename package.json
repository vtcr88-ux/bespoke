{
  "name": "bespoke",
  "private": true,
  "version": "0.1.0",
  "description": "Bespoke premium e-commerce platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "npm --workspace @bespoke/web run dev",
    "dev:admin": "npm --workspace @bespoke/admin run dev",
    "dev:api": "npm --workspace @bespoke/api run dev",
    "db:setup": "npm --workspace @bespoke/api run db:setup",
    "storage:check": "tsx scripts/storage-check.ts",
    "storage:import-file": "tsx scripts/import-local-file-storage.ts",
    "storage:prepare": "npm-run-all --sequential db:setup storage:check",
    "db:migrate:prod": "tsx scripts/db-migrate.ts",
    "db:seed:prod": "tsx scripts/db-seed.ts",
    "admin:create": "npm --workspace @bespoke/api run auth:hash-password",
    "admin:verify": "npm --workspace @bespoke/api run auth:verify-password",
    "instance:create": "tsx scripts/create-instance.ts",
    "instance:list": "tsx scripts/list-instances.ts",
    "instance:api": "tsx scripts/run-instance-api.ts",
    "instance:db:provision": "tsx scripts/provision-instance-db.ts",
    "instance:render": "tsx scripts/render-instance-configs.ts",
    "instance:validate": "tsx scripts/validate-instance-env.ts",
    "env:validate": "npm --workspace @bespoke/api run env:validate",
    "healthcheck": "node scripts/healthcheck.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "build:web": "npm --workspace @bespoke/web run build",
    "build:admin": "npm --workspace @bespoke/admin run build",
    "build:api": "npm --workspace @bespoke/api run build",
    "build:contracts": "npm --workspace @bespoke/contracts run build",
    "build:design-system": "npm --workspace @bespoke/design-system run build",
    "start:prod": "npm --workspace @bespoke/api run start",
    "build": "npm-run-all --sequential build:contracts build:design-system build:api build:web build:admin",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.12",
    "eslint": "^9.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.11"
  }
}
